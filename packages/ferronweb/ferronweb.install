post_install() {
    # ferron-bin reads this to tell a replaced ferronweb from a fresh install
    install -dm755 /var/lib/ferron
    : > /var/lib/ferron/from-ferronweb
    post_upgrade
}

post_upgrade() {
    install -dm755 /var/lib/ferron
    : > /var/lib/ferron/from-ferronweb

    cat << 'EOF'

  ferronweb has moved to ferron-bin

  This package no longer installs anything. The prebuilt binary now lives
  in ferron-bin, which you should install in its place:

      yay -S ferron-bin

  Once that is done, remove the shim:

      yay -R ferronweb

EOF
}