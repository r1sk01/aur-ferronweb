post_install() {
    post_upgrade
}

post_upgrade() {
    cat << 'EOF'

  ferronweb has moved to ferron-bin

  This package installs nothing of its own any more. ferron-bin has been
  installed alongside it, and that is the one to use:

      yay -S ferron-bin

  Once you have confirmed ferron works, this shim can go:

      yay -R ferronweb

EOF
}