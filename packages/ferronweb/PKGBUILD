# Maintainer: Aria Arctic <aria@zeusteam.dev>
# Contributor: Rowan <rowan@zeusteam.dev>
pkgname=ferronweb
pkgver=2.8.1
pkgrel=6
pkgdesc='Shim to push users from this package to the new ferron-bin package'
arch=('x86_64' 'i686' 'armv7h' 'aarch64' 'riscv64')
url='https://ferron.sh'
license=('MIT')
depends=('ferron-bin')
install=ferronweb.install

package() {
    install -dm755 "$pkgdir/usr/share/doc/$pkgname"
    cat > "$pkgdir/usr/share/doc/$pkgname/README" << 'EOF'
ferronweb is now a shim package

The prebuilt binary moved to ferron-bin. Install it directly:

    yay -S ferron-bin

Then remove this package:

    yay -R ferronweb
EOF
}