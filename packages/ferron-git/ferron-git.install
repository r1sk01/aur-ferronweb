post_install() {
    echo "==> Creating ferron user and group..."
    systemd-sysusers
    echo "==> Setting up directories and permissions..."
    systemd-tmpfiles --create
    if [ ! -e /var/www/ferron/index.html ]; then
        echo "==> Seeding /var/www/ferron from /usr/share/ferron/wwwroot"
        cp -r /usr/share/ferron/wwwroot/. /var/www/ferron/
    fi
    chown -R ferron:ferron /var/log/ferron
    chown -R ferron:ferron /var/www/ferron
    chown -R ferron:ferron /var/lib/ferron
    find /var/log/ferron -type d -exec chmod 755 {} \;
    find /var/log/ferron -type f -exec chmod 644 {} \;
    find /var/www/ferron -type d -exec chmod 755 {} \;
    find /var/www/ferron -type f -exec chmod 644 {} \;
    echo "==> Ferron is now installed. Start it with: systemctl start ferron"
}

post_upgrade() {
    # 2.x /etc/ferron.kdl -> 3.x /etc/ferron/ferron.conf.
    # 1.x YAML is a two-step path needing ferron-yaml2kdl, which 2.x packages ship,
    # so that case is left to ferron's own upgrade to handle first.
    if [ -f /etc/ferron.yaml ] && [ ! -f /etc/ferron/ferron.conf ]; then
        echo "==> Detected legacy /etc/ferron.yaml"
        echo "==> Install ferron (2.x) first to convert it to /etc/ferron.kdl, then re-run this upgrade"
    elif [ -f /etc/ferron.kdl ] && [ ! -f /etc/ferron/ferron.conf ]; then
        if command -v ferron-kdl2ferron >/dev/null 2>&1; then
            echo "==> Detected 2.x /etc/ferron.kdl, converting to /etc/ferron/ferron.conf"
            if ferron-kdl2ferron /etc/ferron.kdl /etc/ferron/ferron.conf.new; then
                mv /etc/ferron.kdl /etc/ferron.kdl.bak
                mv /etc/ferron/ferron.conf.new /etc/ferron/ferron.conf
                echo "==> Conversion successful. Backup saved as /etc/ferron.kdl.bak"
            else
                echo "==> WARNING: conversion failed, /etc/ferron/ferron.conf was not written"
                rm -f /etc/ferron/ferron.conf.new
            fi
        else
            echo "==> WARNING: ferron-kdl2ferron not found, cannot convert /etc/ferron.kdl"
        fi
    fi
    if [ ! -e /var/www/ferron/index.html ]; then
        echo "==> Seeding /var/www/ferron from /usr/share/ferron/wwwroot"
        cp -r /usr/share/ferron/wwwroot/. /var/www/ferron/
    fi
    chown -R ferron:ferron /var/log/ferron /var/www/ferron /var/lib/ferron
    find /var/log/ferron -type d -exec chmod 755 {} \;
    find /var/log/ferron -type f -exec chmod 644 {} \;
    find /var/www/ferron -type d -exec chmod 755 {} \;
    find /var/www/ferron -type f -exec chmod 644 {} \;
    if systemctl is-active --quiet ferron; then
        echo "==> Ferron is still running, restart it to apply updates"
    fi
}

post_remove() {
    echo "==> Ferron configuration and data directories are preserved."
    echo "==> Remove them manually if they are no longer needed:"
    echo "    /etc/ferron/ferron.conf"
    echo "    /var/www/ferron"
    echo "    /var/log/ferron"
    echo "    /var/lib/ferron"
}